
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="content">
    <div class="content_resize">
        <div class="mainbar" style="width: 100%; float: none; max-width: 500px; margin: 40px auto;">
            <div class="article">
                <h2 style="text-align: center; color: #D2691E; margin-bottom: 30px;">
                    <span style="font-size: 40px;">🔐</span><br />
                    Giriş Yap
                </h2>
                
                @if (ViewBag.Error != null)
                {
                    <div style="background-color: #ffebee; border-left: 4px solid #f44336; padding: 15px; margin-bottom: 20px; border-radius: 4px;">
                        <strong style="color: #c62828;">⚠️ Hata:</strong>
                        <span style="color: #d32f2f;">@ViewBag.Error</span>
                    </div>
                }
                
                <form asp-action="Login" method="post" style="padding: 20px;">
                    <div style="margin-bottom: 25px;">
                        <label style="display: block; margin-bottom: 8px; color: #555; font-weight: bold;">
                            👤 Kullanıcı Adı
                        </label>
                        <input name="username" 
                               class="form-control" 
                               style="width: 100%; padding: 12px; border: 2px solid #ddd; border-radius: 6px; font-size: 14px; transition: border-color 0.3s;"
                               onfocus="this.style.borderColor='#D2691E'"
                               onblur="this.style.borderColor='#ddd'" 
                               placeholder="Kullanıcı adınızı giriniz"
                               required />
                    </div>
                    
                    <div style="margin-bottom: 25px;">
                        <label style="display: block; margin-bottom: 8px; color: #555; font-weight: bold;">
                            🔒 Şifre
                        </label>
                        <input name="password" 
                               type="password" 
                               class="form-control" 
                               style="width: 100%; padding: 12px; border: 2px solid #ddd; border-radius: 6px; font-size: 14px; transition: border-color 0.3s;"
                               onfocus="this.style.borderColor='#D2691E'"
                               onblur="this.style.borderColor='#ddd'"
                               placeholder="Şifrenizi giriniz"
                               required />
                    </div>
                    
                    <div style="margin-top: 30px; text-align: center;">
                        <button type="submit" 
                                style="background: linear-gradient(135deg, #D2691E 0%, #C85A17 100%); color: white; padding: 14px 40px; border: none; border-radius: 25px; font-size: 16px; font-weight: bold; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 4px 15px rgba(210, 105, 30, 0.3);"
                                onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px rgba(210, 105, 30, 0.4)'"
                                onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(210, 105, 30, 0.3)'">
                            ✓ Giriş Yap
                        </button>
                    </div>
                    
                    <div style="text-align: center; margin-top: 25px; padding-top: 20px; border-top: 1px solid #eee;">
                        <span style="color: #777;">Hesabınız yok mu?</span>
                        <a asp-action="Register" 
                           style="color: #D2691E; text-decoration: none; font-weight: bold; margin-left: 5px;"
                           onmouseover="this.style.textDecoration='underline'"
                           onmouseout="this.style.textDecoration='none'">
                            Kayıt Ol →
                        </a>
                    </div>
                </form>
            </div>
        </div>
        <div class="clr"></div>
    </div>
</div>
