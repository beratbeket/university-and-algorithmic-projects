@model List<Blog>

<div class="mainbar">
    @foreach(var item in Model)
    { <div class="article">
        <h2><span>@item.Name</span></h2>
        <div class="clr"></div>
            <p><span class="date">@item.PublishDate.ToString("MMMM d\\th\\h, yyyy 'at' h:mm tt")</span> Posted by <a href="#">@(string.IsNullOrEmpty(item.AuthorName) ? "Anonim" : item.AuthorName)</a> &nbsp;|&nbsp; Etiketler <a href="#">@item.Tags</a>, <a href="#">internet</a></p>
        <img src="@item.ImageUrl" width="625" height="205" alt="" />
            @{
                string description = item.Description;
                string newdescription = description.Length > 50 ? description.Substring(0,50) + "..." : description;
            }
        <p>@newdescription</p>
        <p class="spec"><a href="/Blogs/Details/@(string.IsNullOrEmpty(item.UrlHandle) ? item.Id : item.UrlHandle)" class="rm">Daha Fazla Göster &raquo;</a> 
                <a href="#" class="com" style="margin-left:6px"><span>@item.CommentCount</span> Comments</a>
       @*          <a href="#" class="com" style="margin-left:6px"><span>@item.LikeCount</span> Like</a> *@
                <a href="#" class="com" style="margin-left:6px"><span>@item.ViewCount</span> View</a>
        </p>
    </div>
    }
   
</div>
